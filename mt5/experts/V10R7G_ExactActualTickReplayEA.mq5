bool opened[ACTION_COUNT];
bool finished[ACTION_COUNT];

string Tag(const int i){ return StringFormat("V10R7_%d",(int)A[i].id); }

double NormalizeVolume(double v)
  {
   double mn=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN);
   double mx=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MAX);
   double st=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP);
   if(st<=0.0) st=(mn>0?mn:0.01);
   v=MathMin(mx,MathMax(mn,v));
   double z=MathFloor(v/st+1e-9)*st;
   int dg=2; if(st<0.01) dg=3; if(st<0.001) dg=4;
   return NormalizeDouble(z,dg);
  }

bool FindPositionByTag(string tag,ulong &ticket)
  {
   for(int i=PositionsTotal()-1;i>=0;i--)
     {
      ulong t=PositionGetTicket(i);
      if(t==0 || !PositionSelectByTicket(t)) continue;
      if(PositionGetString(POSITION_SYMBOL)!=_Symbol) continue;
      if((long)PositionGetInteger(POSITION_MAGIC)!=InpMagicNumber) continue;
      if(PositionGetString(POSITION_COMMENT)==tag){ticket=t;return true;}
     }
   ticket=0; return false;
  }

bool OpenAction(const int i)
  {
   if(opened[i]||finished[i]) return false;
   double vol=NormalizeVolume(InpLotPerUnit*A[i].units);
   if(vol<SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN)-1e-12){finished[i]=true;return false;}
   trade.SetExpertMagicNumber(InpMagicNumber);
   trade.SetDeviationInPoints(InpDeviationPoints);
   string tag=Tag(i);
   double sl=NormalizeDouble(A[i].stop,(int)SymbolInfoInteger(_Symbol,SYMBOL_DIGITS));
   bool ok=(A[i].dir>0 ? trade.Buy(vol,_Symbol,0.0,sl,0.0,tag)
                       : trade.Sell(vol,_Symbol,0.0,sl,0.0,tag));
   if(ok)
     {
      opened[i]=true;
      if(InpVerbose) Print("OPEN ",tag," units=",A[i].units," vol=",DoubleToString(vol,2)," sl=",DoubleToString(sl,_Digits));
      return true;
     }
   if(InpVerbose) Print("OPEN_FAIL ",tag," ret=",trade.ResultRetcode()," ",trade.ResultRetcodeDescription());
   return false; // retry on later tick while still same action time region
  }

void TryFinishAction(const int i)
  {
   if(finished[i]||!opened[i]) return;
   ulong ticket=0;
   if(!FindPositionByTag(Tag(i),ticket))
     {
      finished[i]=true; // broker SL / already closed
      return;
     }
   if(A[i].hard_sl_exit) return; // let the attached hard SL execute on actual ticks
   if(TimeCurrent()<A[i].exit_time) return;
   trade.SetExpertMagicNumber(InpMagicNumber);
   trade.SetDeviationInPoints(InpDeviationPoints);
   if(trade.PositionClose(ticket,InpDeviationPoints))
     {
      finished[i]=true;
      if(InpVerbose) Print("FAST_HA_EXIT ",Tag(i));
     }
   else if(InpVerbose)
      Print("EXIT_PENDING ",Tag(i)," ret=",trade.ResultRetcode()," ",trade.ResultRetcodeDescription());
  }

int OnInit()
  {
   if((ENUM_ACCOUNT_MARGIN_MODE)AccountInfoInteger(ACCOUNT_MARGIN_MODE)!=ACCOUNT_MARGIN_MODE_RETAIL_HEDGING)
     {
      Print("V10R7G replay requires MT5 hedging account mode.");
      return INIT_FAILED;
     }
   ArrayInitialize(opened,false);
   ArrayInitialize(finished,false);
   trade.SetExpertMagicNumber(InpMagicNumber);
   return INIT_SUCCEEDED;
  }

void OnTick()
  {
   datetime now=TimeCurrent();
   for(int i=0;i<ACTION_COUNT;i++)
     {
      if(finished[i]) continue;
      if(opened[i]){TryFinishAction(i);continue;}
      if(now<A[i].entry_time) continue;
      // Do not back-fill an action after its frozen campaign exit time.
      if(now>=A[i].exit_time){finished[i]=true;continue;}
      OpenAction(i);
     }
  }
//+------------------------------------------------------------------+
