int V10StageDirIndex(int stage,int dir){int s=(stage<=1?0:(stage==2?1:2)); return s*2+(dir>0?0:1);}
int V10ModelId(int head,int stage,int dir,int year){ if(year<2024||year>2026)return -1; int sd=V10StageDirIndex(stage,dir); return (year-2024)*18+sd*3+head; }
double V10Sigmoid(double z){if(z>=0.0){double e=MathExp(-z);return 1.0/(1.0+e);}double e=MathExp(z);return e/(1.0+e);}
double V10EvalModel(int mid,const double &x[]){if(mid<0||mid>=V10R7G_MODEL_COUNT)return 0.0; V10ModelMeta m=V10_MM[mid]; double raw=m.bias; if(m.kind==0){for(int ti=0;ti<m.tree_count;ti++){int ni=V10_ROOTS[m.tree_start+ti];while(V10_BN[ni].f>=0){V10BinNode n=V10_BN[ni];bool go=false;if(m.family==V10_FAM_XGB){float v=(float)x[n.f];float t=(float)n.t;go=(v<t);}else{go=(x[n.f]<=n.t);}ni=go?n.l:n.r;}raw+=V10_BN[ni].leaf;}raw*=m.scale;}else{double sm=0.0;for(int ti=0;ti<m.tree_count;ti++){V10ObTree tr=V10_OT[m.tree_start+ti];int idx=0;for(int j=0;j<tr.split_count;j++){int p=tr.split_start+j;float v=(float)x[V10_OSF[p]];float t=(float)V10_OST[p];if(v>t)idx|=(1<<j);}sm+=V10_OL[tr.leaf_start+idx];}raw=m.scale*sm+m.bias;}return m.link?V10Sigmoid(raw):raw;}
