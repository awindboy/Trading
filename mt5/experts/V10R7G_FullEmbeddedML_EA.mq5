input group "Sizing"
input V10SizingMode  InpSizingMode           = V10_FIXED_LOT_PER_UNIT;
input double         InpLotPerUnit           = 0.01;
input double         InpRiskPctPerUnit       = 1.0;

input group "R7G frozen shadow"
input bool           InpEnableR7G            = true;
input int            InpFeedbackH4Bars       = 180; // frozen historical R7G value

input group "Diagnostics"
input bool           InpWriteCsv             = true;
input bool           InpVerbose              = false;
input string         InpCsvFile              = "V10_R7G_full_embedded_ml_events.csv";

struct ShadowCandidate
  {
   bool     used;
   bool     resolved;
   int      dir;
   int      h4_index;
   datetime decision;
   datetime exit_time;
   double   entry;
   double   stop;
   double   R;
  };

CTrade g_trade;
datetime g_last_h4_open=0;
int      g_prev_fast_dir=0;
long     g_h4_index=0;
bool     g_exit_pending=false;
int      g_exit_old_dir=0;
int      g_csv=INVALID_HANDLE;
long     g_decisions=0;
long     g_entries=0;

// rank history: last 360 opportunity rows separately for each stage x direction.
double g_rank_hist[RANK_SD][RANK_F][RANK_W];
int    g_rank_count[RANK_SD];
int    g_rank_pos[RANK_SD];

ShadowCandidate g_shadow[SHADOW_MAX];
int g_shadow_n=0;

void VLog(string s){if(InpVerbose)Print("[V10R7G] ",s);}
double BidNow(){return SymbolInfoDouble(_Symbol,SYMBOL_BID);}
double AskNow(){return SymbolInfoDouble(_Symbol,SYMBOL_ASK);}
double NormPrice(double p){return NormalizeDouble(p,(int)SymbolInfoInteger(_Symbol,SYMBOL_DIGITS));}
string DirName(int d){return d>0?"LONG":(d<0?"SHORT":"NONE");}

void CsvHeader()
  {
   if(g_csv==INVALID_HANDLE)return;
   FileWrite(g_csv,"event_time","decision","event","dir","k","year","score","q50","q75","r4_weight",
             "p_stop","mu_nonstop","EV","feedback_R","r7g_weight","entry_chart","stop","volume","note");
   FileFlush(g_csv);
  }

void CsvEvent(datetime decision,string ev,int dir,int k,double score,double q50,double q75,int w4,
              double ps,double mu,double evalue,double fb,int w7,double entry,double stop,double vol,string note)
  {
   if(g_csv==INVALID_HANDLE)return;
   MqlDateTime dt;TimeToStruct(decision,dt);
   FileWrite(g_csv,TimeToString(TimeCurrent(),TIME_DATE|TIME_SECONDS),TimeToString(decision,TIME_DATE|TIME_MINUTES),ev,
             DirName(dir),k,dt.year,DoubleToString(score,10),DoubleToString(q50,10),DoubleToString(q75,10),w4,
             DoubleToString(ps,10),DoubleToString(mu,10),DoubleToString(evalue,10),
             (fb!=EMPTY_VALUE&&MathIsValidNumber(fb))?DoubleToString(fb,10):"",w7,DoubleToString(entry,_Digits),DoubleToString(stop,_Digits),DoubleToString(vol,4),note);
   FileFlush(g_csv);
  }

//---------------- HA / indicators ----------------------------------
int BuildHA(ENUM_TIMEFRAMES tf,int want,double close_weight,double alpha,
            MqlRates &r[],double &hao[],double &hac[],double &hah[],double &hal[],int &dir[])
  {
   ArrayResize(r,want);ArraySetAsSeries(r,false);
   int n=CopyRates(_Symbol,tf,0,want,r);
   if(n<=0)return 0;
   ArrayResize(r,n);ArrayResize(hao,n);ArrayResize(hac,n);ArrayResize(hah,n);ArrayResize(hal,n);ArrayResize(dir,n);
   for(int i=0;i<n;i++)
     {
      hac[i]=(r[i].open+r[i].high+r[i].low+close_weight*r[i].close)/(3.0+close_weight);
      if(i==0)hao[i]=0.5*(r[i].open+r[i].close);
      else hao[i]=alpha*hao[i-1]+(1.0-alpha)*hac[i-1];
      hah[i]=MathMax(r[i].high,MathMax(hao[i],hac[i]));
      hal[i]=MathMin(r[i].low,MathMin(hao[i],hac[i]));
      dir[i]=(hac[i]>=hao[i]?1:-1);
     }
   return n;
  }

void CalcATR(const MqlRates &r[],int period,double &out[])
  {
   int n=ArraySize(r);ArrayResize(out,n);ArrayInitialize(out,EMPTY_VALUE);if(n<period)return;
   double tr[];ArrayResize(tr,n);tr[0]=r[0].high-r[0].low;
   for(int i=1;i<n;i++)tr[i]=MathMax(r[i].high-r[i].low,MathMax(MathAbs(r[i].high-r[i-1].close),MathAbs(r[i].low-r[i-1].close)));
   double a=0.0;for(int i=0;i<period;i++)a+=tr[i];a/=period;out[period-1]=a;
   for(int i=period;i<n;i++){a=(a*(period-1)+tr[i])/period;out[i]=a;}
  }

void CalcEMA(const MqlRates &r[],int period,double &out[])
  {
   int n=ArraySize(r);ArrayResize(out,n);if(n<=0)return;double a=2.0/(period+1.0);out[0]=r[0].close;
   for(int i=1;i<n;i++)out[i]=a*r[i].close+(1.0-a)*out[i-1];
  }

void CalcADX(const MqlRates &r[],int period,double &adx[],double &pdi[],double &mdi[])
  {
   int n=ArraySize(r);ArrayResize(adx,n);ArrayResize(pdi,n);ArrayResize(mdi,n);
   ArrayInitialize(adx,EMPTY_VALUE);ArrayInitialize(pdi,EMPTY_VALUE);ArrayInitialize(mdi,EMPTY_VALUE);
   if(n<=2*period+2)return;
   double tr[],pdm[],mdm[],atrS[],sp[],sm[],dx[];
   ArrayResize(tr,n);ArrayResize(pdm,n);ArrayResize(mdm,n);ArrayResize(atrS,n);ArrayResize(sp,n);ArrayResize(sm,n);ArrayResize(dx,n);
   ArrayInitialize(atrS,EMPTY_VALUE);ArrayInitialize(sp,EMPTY_VALUE);ArrayInitialize(sm,EMPTY_VALUE);ArrayInitialize(dx,EMPTY_VALUE);
   tr[0]=r[0].high-r[0].low;pdm[0]=0;mdm[0]=0;
   for(int i=1;i<n;i++)
     {
      tr[i]=MathMax(r[i].high-r[i].low,MathMax(MathAbs(r[i].high-r[i-1].close),MathAbs(r[i].low-r[i-1].close)));
      double up=r[i].high-r[i-1].high,dn=r[i-1].low-r[i].low;
      pdm[i]=(up>dn&&up>0?up:0);mdm[i]=(dn>up&&dn>0?dn:0);
     }
   double at=0,ps=0,ms=0;for(int i=1;i<=period;i++){at+=tr[i];ps+=pdm[i];ms+=mdm[i];}
   atrS[period]=at;sp[period]=ps;sm[period]=ms;
   for(int i=period+1;i<n;i++){atrS[i]=atrS[i-1]-atrS[i-1]/period+tr[i];sp[i]=sp[i-1]-sp[i-1]/period+pdm[i];sm[i]=sm[i-1]-sm[i-1]/period+mdm[i];}
   for(int i=period;i<n;i++)
     {
      if(atrS[i]<=0)continue;pdi[i]=100.0*sp[i]/atrS[i];mdi[i]=100.0*sm[i]/atrS[i];double den=pdi[i]+mdi[i];if(den>EPS)dx[i]=100.0*MathAbs(pdi[i]-mdi[i])/den;
     }
   int start=2*period;double sum=0;int cnt=0;for(int i=period+1;i<=start;i++)if(dx[i]!=EMPTY_VALUE){sum+=dx[i];cnt++;}
   if(cnt<=0)return;adx[start]=sum/cnt;for(int i=start+1;i<n;i++)if(dx[i]!=EMPTY_VALUE&&adx[i-1]!=EMPTY_VALUE)adx[i]=(adx[i-1]*(period-1)+dx[i])/period;
  }

double PathEffAt(const MqlRates &r[],int idx,int w)
  {
   if(idx-w+1<0)return EMPTY_VALUE;double den=0;for(int i=idx-w+2;i<=idx;i++)den+=MathAbs(r[i].close-r[i-1].close);if(den<=EPS)return 0.0;return MathAbs(r[idx].close-r[idx-w+1].close)/den;
  }

double PriorPathMedian(const MqlRates &r[],int idx,int w,int lookback)
  {
   double a[];ArrayResize(a,0);for(int j=MathMax(0,idx-lookback);j<=idx-1;j++){double v=PathEffAt(r,j,w);if(v==EMPTY_VALUE||!MathIsValidNumber(v))continue;int z=ArraySize(a);ArrayResize(a,z+1);a[z]=v;}
   int n=ArraySize(a);if(n<60)return EMPTY_VALUE;ArraySort(a);return (n%2?a[n/2]:0.5*(a[n/2-1]+a[n/2]));
  }

double PriorMedian(const double &src[],int idx,int lookback)
  {
   double a[];ArrayResize(a,0);for(int j=MathMax(0,idx-lookback);j<=idx-1;j++){double v=src[j];if(v==EMPTY_VALUE||!MathIsValidNumber(v))continue;int z=ArraySize(a);ArrayResize(a,z+1);a[z]=v;}
   int n=ArraySize(a);if(n<60)return EMPTY_VALUE;ArraySort(a);return (n%2?a[n/2]:0.5*(a[n/2-1]+a[n/2]));
  }

double FlipRate(const int &d[],int idx,int w)
  {
   if(idx-w+1<0)return EMPTY_VALUE;int c=0;for(int i=idx-w+2;i<=idx;i++)if(d[i]!=d[i-1])c++;return (double)c/(w-1);
  }

double Std3(double a,double b,double c)
  {
   double m=(a+b+c)/3.0;return MathSqrt(((a-m)*(a-m)+(b-m)*(b-m)+(c-m)*(c-m))/2.0);
  }

bool LTFWindow(ENUM_TIMEFRAMES tf,double cw,double alpha,datetime start,datetime end,double scale,int pdir,
               double &aligned,double &transition,double &streak,double &body_sum_atr,double &body_eff,double &body_rng,double &opp_wick)
  {
   MqlRates r[];double ho[],hc[],hh[],hl[];int hd[];int n=BuildHA(tf,LTF_HISTORY,cw,alpha,r,ho,hc,hh,hl,hd);if(n<10)return false;
   int ids[];ArrayResize(ids,0);for(int i=0;i<n;i++)if(r[i].time>=start&&r[i].time<end){int z=ArraySize(ids);ArrayResize(ids,z+1);ids[z]=i;}
   int m=ArraySize(ids);if(m<=0)return false;
   int ac=0,trans=0;double bsum=0,abssum=0,br=0,ow=0;
   int prevsg=0;
   for(int z=0;z<m;z++)
     {
      int i=ids[z];int sg=pdir*hd[i];if(sg>0)ac++;if(z>0&&sg!=prevsg)trans++;prevsg=sg;
      double body=pdir*(hc[i]-ho[i]);double range=MathMax(hh[i]-hl[i],1e-9);bsum+=body;abssum+=MathAbs(body);br+=body/range;
      double wick=(pdir>0?MathMax(0.0,MathMin(ho[i],hc[i])-hl[i]):MathMax(0.0,hh[i]-MathMax(ho[i],hc[i])));ow+=wick/range;
     }
   int lastsg=pdir*hd[ids[m-1]],cur=0;for(int z=m-1;z>=0;z--){int sg=pdir*hd[ids[z]];if(sg==lastsg)cur++;else break;}
   aligned=(double)ac/m;transition=(double)trans/MathMax(1,m-1);streak=(lastsg>0?cur:-cur);body_sum_atr=bsum/MathMax(scale,1e-9);body_eff=bsum/MathMax(abssum,1e-9);body_rng=br/m;opp_wick=ow/m;return true;
  }

// Build 38 raw + 33 engineered features. Rank features are added later.
bool BuildFeatures(datetime h4open,double &x[],int &pdir,int &run_k,double &stop,double &entry_chart,bool &late_opportunity)
  {
   MqlRates r[];double fho[],fhc[],fhh[],fhl[];int fd[];int n=BuildHA(PERIOD_H4,H4_HISTORY,2.0,0.25,r,fho,fhc,fhh,fhl,fd);if(n<250)return false;
   MqlRates rs[];double sho[],shc[],shh[],shl[];int sd[];if(BuildHA(PERIOD_H4,H4_HISTORY,1.0,0.50,rs,sho,shc,shh,shl,sd)!=n)return false;
   MqlRates rl[];double slo[],slc[],slh[],sll[];int sld[];if(BuildHA(PERIOD_H4,H4_HISTORY,2.0,0.75,rl,slo,slc,slh,sll,sld)!=n)return false;
   int idx=n-2;if(idx<181)return false;
   datetime theoretical=r[idx].time+4*60*60;late_opportunity=((long)TimeCurrent()-(long)theoretical>4*60*60);
   pdir=fd[idx];run_k=1;for(int j=idx-1;j>=0&&fd[j]==pdir;j--)run_k++;
   entry_chart=BidNow();if(entry_chart<=0)return false;
   stop=(pdir>0?shl[idx-1]:shh[idx-1]);
   if((pdir>0&&stop>=entry_chart)||(pdir<0&&stop<=entry_chart))return false;
   double atr[];CalcATR(r,180,atr);double scale=atr[idx-1];if(scale==EMPTY_VALUE||!MathIsValidNumber(scale)||scale<=0)return false;
   double adx14[],pdi14[],mdi14[],adx28[],pdi28[],mdi28[];CalcADX(r,14,adx14,pdi14,mdi14);CalcADX(r,28,adx28,pdi28,mdi28);
   if(adx14[idx]==EMPTY_VALUE||adx28[idx]==EMPTY_VALUE)return false;
   double adxmed=PriorMedian(adx28,idx,180),pe4=PathEffAt(r,idx,4),pe12=PathEffAt(r,idx,12),pm4=PriorPathMedian(r,idx,4,180),pm12=PriorPathMedian(r,idx,12,180);
   if(adxmed==EMPTY_VALUE||pm4==EMPTY_VALUE||pm12==EMPTY_VALUE||adxmed<=0||pm4<=0||pm12<=0)return false;
   double e8[],e21[];CalcEMA(r,8,e8);CalcEMA(r,21,e21);
   double m15a,m15t,m15s,m15bs,m15be,m15br,m15ow;
   double m30a,m30t,m30s,m30bs,m30be,m30br,m30ow;
   double h1a,h1t,h1s,h1bs,h1be,h1br,h1ow;
   if(!LTFWindow(PERIOD_M15,2.0,0.25,r[idx].time,h4open,scale,pdir,m15a,m15t,m15s,m15bs,m15be,m15br,m15ow))return false;
   if(!LTFWindow(PERIOD_M30,2.0,0.25,r[idx].time,h4open,scale,pdir,m30a,m30t,m30s,m30bs,m30be,m30br,m30ow))return false;
   if(!LTFWindow(PERIOD_H1,1.0,0.50,r[idx].time,h4open,scale,pdir,h1a,h1t,h1s,h1bs,h1be,h1br,h1ow))return false;

   ArrayResize(x,V10R7G_FEATURE_COUNT);ArrayInitialize(x,0.0);
   double frng=MathMax(fhh[idx]-fhl[idx],1e-9),srng=MathMax(shh[idx]-shl[idx],1e-9),lrng=MathMax(slh[idx]-sll[idx],1e-9);
   x[0]=MathAbs(entry_chart-stop)/scale;
   x[1]=pdir*(fhc[idx]-fho[idx])/frng;
   x[2]=pdir*(fhc[idx]-fho[idx])/scale;
   x[3]=(sd[idx]==pdir?1.0:0.0);
   x[4]=pdir*(shc[idx]-sho[idx])/srng;
   x[5]=(sld[idx]==pdir?1.0:0.0);
   x[6]=pdir*(slc[idx]-slo[idx])/lrng;
   x[7]=adx28[idx]/adxmed;
   x[8]=pdir*(pdi14[idx]-mdi14[idx])/100.0;
   x[9]=pdir*(pdi28[idx]-mdi28[idx])/100.0;
   x[10]=pdir*(e8[idx]-e21[idx])/scale;
   x[11]=pdir*(e8[idx]-e8[idx-1])/scale;
   x[12]=pe4/pm4;x[13]=pe12/pm12;x[14]=FlipRate(fd,idx,4);x[15]=FlipRate(fd,idx,8);x[16]=FlipRate(fd,idx,12);
   x[17]=m15a;x[18]=m15t;x[19]=m15s;x[20]=m15bs;x[21]=m15be;x[22]=m15br;x[23]=m15ow;
   x[24]=m30a;x[25]=m30t;x[26]=m30s;x[27]=m30bs;x[28]=m30be;x[29]=m30br;x[30]=m30ow;
   x[31]=h1a;x[32]=h1t;x[33]=h1s;x[34]=h1bs;x[35]=h1be;x[36]=h1br;x[37]=h1ow;

   // engineered 38..70; pandas std(axis=1) uses sample std (ddof=1).
   x[38]=MathLog(1.0+MathMax(x[0],0.0));x[39]=x[1];x[40]=(x[3]+x[5])/2.0;x[41]=(x[3]!=x[5]?1.0:0.0);
   x[42]=(x[1]+x[4]+x[6])/3.0;x[43]=Std3(x[1],x[4],x[6]);x[44]=x[7];x[45]=(x[8]+x[9])/2.0;x[46]=MathAbs(x[8]-x[9]);
   x[47]=x[10];x[48]=x[11];x[49]=(x[12]+x[13])/2.0;x[50]=x[12]/(MathAbs(x[13])+1e-6);x[51]=(x[14]+x[15]+x[16])/3.0;x[52]=x[14]-x[16];
   x[53]=(x[17]+x[24]+x[31])/3.0;x[54]=Std3(x[17],x[24],x[31]);x[55]=(x[18]+x[25]+x[32])/3.0;x[56]=Std3(x[18],x[25],x[32]);
   x[57]=(x[19]+x[26]+x[33])/3.0;x[58]=Std3(x[19],x[26],x[33]);x[59]=(x[20]+x[27]+x[34])/3.0;x[60]=Std3(x[20],x[27],x[34]);
   x[61]=(x[21]+x[28]+x[35])/3.0;x[62]=Std3(x[21],x[28],x[35]);x[63]=(x[22]+x[29]+x[36])/3.0;x[64]=Std3(x[22],x[29],x[36]);
   x[65]=(x[23]+x[30]+x[37])/3.0;x[66]=Std3(x[23],x[30],x[37]);x[67]=x[44]*x[63];x[68]=x[49]*x[63];x[69]=x[45]*x[63];x[70]=x[42]*x[63];
   return true;
  }

//---------------- causal rank features ------------------------------
int RankRawIndex(int j)
  {
   int a[RANK_F]={0,1,4,6,7,8,10,12,13,15,22,29,36};return a[j];
  }

void ApplyAndPushRanks(int stage,int dir,double &x[])
  {
   int sd=V10StageDirIndex(stage,dir),cnt=g_rank_count[sd];
   for(int j=0;j<RANK_F;j++)
     {
      double v=x[RankRawIndex(j)];double rk=0.5;
      if(cnt>=40)
        {
         int le=0;for(int z=0;z<cnt;z++)if(g_rank_hist[sd][j][z]<=v)le++;
         rk=(le+0.5)/(cnt+1.0);
        }
      x[71+j]=rk;
     }
   int pos=g_rank_pos[sd];for(int j=0;j<RANK_F;j++)g_rank_hist[sd][j][pos]=x[RankRawIndex(j)];
   if(cnt<RANK_W)g_rank_count[sd]++;
   g_rank_pos[sd]=(pos+1)%RANK_W;
  }

//---------------- shadow feedback ----------------------------------
void ResolveShadowStops()
  {
   double p=BidNow();if(p<=0)return;datetime now=TimeCurrent();
   for(int i=0;i<g_shadow_n;i++)
     {
      if(!g_shadow[i].used||g_shadow[i].resolved)continue;
      bool hit=(g_shadow[i].dir>0?p<=g_shadow[i].stop:p>=g_shadow[i].stop);if(!hit)continue;
      g_shadow[i].resolved=true;g_shadow[i].exit_time=now;g_shadow[i].R=-1.0;
     }
  }

void ResolveShadowNHA(int olddir,datetime decision,double exit_price)
  {
   for(int i=0;i<g_shadow_n;i++)
     {
      if(!g_shadow[i].used||g_shadow[i].resolved||g_shadow[i].dir!=olddir)continue;
      double risk=MathAbs(g_shadow[i].entry-g_shadow[i].stop);if(risk<=EPS)continue;
      g_shadow[i].resolved=true;g_shadow[i].exit_time=decision;g_shadow[i].R=g_shadow[i].dir*(exit_price-g_shadow[i].entry)/risk;
     }
  }

double FeedbackMean(datetime decision,int current_h4_index,bool &has)
  {
   double s=0;int n=0;int lo=current_h4_index-InpFeedbackH4Bars;
   for(int i=0;i<g_shadow_n;i++)
     {
      if(!g_shadow[i].used||!g_shadow[i].resolved)continue;if(g_shadow[i].h4_index<lo||g_shadow[i].h4_index>=current_h4_index)continue;
      if(g_shadow[i].exit_time>=decision)continue;s+=g_shadow[i].R;n++;
     }
   has=(n>0);return n>0?s/n:0.0;
  }

void AddShadowCandidate(int dir,int h4idx,datetime decision,double entry,double stop)
  {
   if(g_shadow_n>=SHADOW_MAX)return;int i=g_shadow_n++;g_shadow[i].used=true;g_shadow[i].resolved=false;g_shadow[i].dir=dir;g_shadow[i].h4_index=h4idx;
   g_shadow[i].decision=decision;g_shadow[i].exit_time=0;g_shadow[i].entry=entry;g_shadow[i].stop=stop;g_shadow[i].R=0.0;
  }

//---------------- positions / execution -----------------------------
bool IsMagicPosition(ulong ticket)
  {
   if(ticket==0||!PositionSelectByTicket(ticket))return false;return PositionGetString(POSITION_SYMBOL)==_Symbol&&(long)PositionGetInteger(POSITION_MAGIC)==InpMagicNumber;
  }
int PositionDir(ulong ticket){if(!PositionSelectByTicket(ticket))return 0;return PositionGetInteger(POSITION_TYPE)==POSITION_TYPE_BUY?1:-1;}
bool HasDirection(int dir){for(int i=0;i<PositionsTotal();i++){ulong t=PositionGetTicket(i);if(IsMagicPosition(t)&&PositionDir(t)==dir)return true;}return false;}

bool CloseDirection(int dir)
  {
   bool all=true;g_trade.SetExpertMagicNumber(InpMagicNumber);g_trade.SetDeviationInPoints(InpDeviationPoints);
   for(int i=PositionsTotal()-1;i>=0;i--){ulong t=PositionGetTicket(i);if(!IsMagicPosition(t)||PositionDir(t)!=dir)continue;if(!g_trade.PositionClose(t,InpDeviationPoints))all=false;}
   return all&&!HasDirection(dir);
  }

void TryPendingExit()
  {
   if(!g_exit_pending)return;if(!HasDirection(g_exit_old_dir)){g_exit_pending=false;g_exit_old_dir=0;return;}if(CloseDirection(g_exit_old_dir)){g_exit_pending=false;g_exit_old_dir=0;}
  }

double NormalizeVolumeFloor(double v)
  {
   double mn=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN),mx=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MAX),st=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP);if(st<=0)st=mn;if(v>mx)v=mx;
   double z=MathFloor((v+1e-12)/st)*st;int d=2;if(st<0.01)d=3;if(st<0.001)d=4;return NormalizeDouble(z,d);
  }

bool VolumeForUnits(int dir,double entry,double sl,int units,double &volume)
  {
   if(units<=0)return false;
   if(InpSizingMode==V10_FIXED_LOT_PER_UNIT){volume=NormalizeVolumeFloor(InpLotPerUnit*units);return volume>=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN)-1e-12;}
   double one=0;ENUM_ORDER_TYPE typ=(dir>0?ORDER_TYPE_BUY:ORDER_TYPE_SELL);if(!OrderCalcProfit(typ,_Symbol,1.0,entry,sl,one)||MathAbs(one)<=EPS)return false;
   double risk=AccountInfoDouble(ACCOUNT_EQUITY)*(InpRiskPctPerUnit/100.0)*units;volume=NormalizeVolumeFloor(risk/MathAbs(one));return volume>=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN)-1e-12;
  }

bool OpenChild(datetime decision,int dir,int k,int units,double stop,double &volume)
  {
   double order_entry=(dir>0?AskNow():BidNow());if(order_entry<=0)return false;if(!VolumeForUnits(dir,order_entry,stop,units,volume))return false;
   if(!InpExecuteTrades)return true;g_trade.SetExpertMagicNumber(InpMagicNumber);g_trade.SetDeviationInPoints(InpDeviationPoints);
   string c=StringFormat("R7G_U%d_K%d",units,k);bool ok=(dir>0?g_trade.Buy(volume,_Symbol,0,NormPrice(stop),0,c):g_trade.Sell(volume,_Symbol,0,NormPrice(stop),0,c));if(ok)g_entries++;return ok;
  }

//---------------- decision engine ----------------------------------
void ProcessDecision(datetime h4open)
  {
   g_h4_index++;
   double x[];int dir=0,k=0;double stop=0,entry_chart=0;bool late=false;
   bool feat_ok=BuildFeatures(h4open,x,dir,k,stop,entry_chart,late);

   // FAST campaign exit is independent of whether the new Child has a valid stop/feature row.
   if(dir!=0)
     {
      bool flip=(g_prev_fast_dir!=0&&dir!=g_prev_fast_dir);
      if(flip)
        {
         double px=BidNow();ResolveShadowNHA(g_prev_fast_dir,h4open,px);
         if(HasDirection(g_prev_fast_dir)){g_exit_pending=true;g_exit_old_dir=g_prev_fast_dir;TryPendingExit();}
        }
      g_prev_fast_dir=dir;
     }
   if(!feat_ok){VLog("feature build failed");return;}

   // Weekend / long-gap H4 completions update HA/campaign state but are not opportunity rows.
   if(late)return;

   int stage=(k==1?1:(k==2?2:3));
   ApplyAndPushRanks(stage,dir,x); // rank is prior-only, then current opportunity row is appended.

   MqlDateTime dt;TimeToStruct(h4open,dt);if(dt.year<2024||dt.year>2026)return;
   int m4=V10ModelId(0,stage,dir,dt.year),ms=V10ModelId(1,stage,dir,dt.year),mr=V10ModelId(2,stage,dir,dt.year);if(m4<0||ms<0||mr<0)return;
   double score=V10EvalModel(m4,x),ps=V10EvalModel(ms,x),mu=V10EvalModel(mr,x),ev=-ps+(1.0-ps)*mu;
   double q50=0,q75=0;if(!V10R4Thresholds(h4open,stage,dir,q50,q75))return;int w4=V10R4Weight(score,q50,q75);

   bool hasfb=false;double fb=FeedbackMean(h4open,(int)g_h4_index,hasfb);int w7=w4;
   if(InpEnableR7G&&w4==1&&ev>0.0&&hasfb&&fb>0.0)w7=3;

   // This candidate joins future feedback only after current feedback has been computed.
   if(w4==1&&ev>0.0)AddShadowCandidate(dir,(int)g_h4_index,h4open,entry_chart,stop);

   g_decisions++;
   if(h4open<InpTradeFrom||h4open>=InpTradeUntil){CsvEvent(h4open,"SHADOW_WARMUP",dir,k,score,q50,q75,w4,ps,mu,ev,hasfb?fb:EMPTY_VALUE,w7,entry_chart,stop,0,"");return;}
   if(g_exit_pending){CsvEvent(h4open,"EXIT_PENDING_BLOCK",dir,k,score,q50,q75,w4,ps,mu,ev,hasfb?fb:EMPTY_VALUE,w7,entry_chart,stop,0,"");return;}
   if(w7<=0){CsvEvent(h4open,"NO_ENTRY",dir,k,score,q50,q75,w4,ps,mu,ev,hasfb?fb:EMPTY_VALUE,w7,entry_chart,stop,0,"");return;}
   double vol=0;bool ok=OpenChild(h4open,dir,k,w7,stop,vol);CsvEvent(h4open,ok?"ENTRY":"ORDER_FAIL",dir,k,score,q50,q75,w4,ps,mu,ev,hasfb?fb:EMPTY_VALUE,w7,entry_chart,stop,vol,ok?"":"open failed");
  }

int OnInit()
  {
   if(InpRequireHedging&&(ENUM_ACCOUNT_MARGIN_MODE)AccountInfoInteger(ACCOUNT_MARGIN_MODE)!=ACCOUNT_MARGIN_MODE_RETAIL_HEDGING){Print("V10R7G requires a hedging account for Child stacking.");return INIT_FAILED;}
   g_trade.SetExpertMagicNumber(InpMagicNumber);g_trade.SetDeviationInPoints(InpDeviationPoints);
   if(InpWriteCsv){g_csv=FileOpen(InpCsvFile,FILE_WRITE|FILE_CSV|FILE_ANSI,',');if(g_csv!=INVALID_HANDLE)CsvHeader();}
   g_last_h4_open=iTime(_Symbol,PERIOD_H4,0);
   Print(V10_BUILD," initialized. For exact causal warm-up start Strategy Tester at 2022-01-03 or earlier. Trades begin at ",TimeToString(InpTradeFrom));
   return INIT_SUCCEEDED;
  }

void OnDeinit(const int reason){if(g_csv!=INVALID_HANDLE){FileFlush(g_csv);FileClose(g_csv);}Print(V10_BUILD," decisions=",g_decisions," entries=",g_entries," shadow=",g_shadow_n);}

void OnTick()
  {
   ResolveShadowStops();TryPendingExit();datetime h4=iTime(_Symbol,PERIOD_H4,0);if(h4<=0)return;
   if(g_last_h4_open==0){g_last_h4_open=h4;return;}
   if(h4!=g_last_h4_open){g_last_h4_open=h4;ProcessDecision(h4);}
  }
