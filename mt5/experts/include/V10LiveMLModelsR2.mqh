double V10MLSigmoid(double z){ if(z>35.0) z=35.0; if(z<-35.0) z=-35.0; return 1.0/(1.0+MathExp(-z)); }
double V10MLPredict(const V10MLEra era,const V10MLHead head,const double &x[]){ double z=V10ML_INTERCEPT[(int)era][(int)head]; for(int i=0;i<V10ML_FEATURES;i++){ double s=V10ML_SCALE[(int)era][(int)head][i]; if(MathAbs(s)<1e-12) s=1.0; z += V10ML_COEF[(int)era][(int)head][i]*((x[i]-V10ML_MEAN[(int)era][(int)head][i])/s); } return V10MLSigmoid(z); }
V10MLEra V10MLEraForTime(datetime t){ MqlDateTime d; TimeToStruct(t,d); if(d.year<=2023) return V10_ERA_2023; if(d.year==2024) return V10_ERA_2024; if(d.year==2025) return V10_ERA_2025; if(d.year==2026) return V10_ERA_2026; return V10_ERA_FUTURE; }

