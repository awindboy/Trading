input bool   InpShowATRRank = true;
input bool   InpShowDistanceRank = true;

input group "Display / Safety"
input int    InpHistoryBars = 20000;       // 0 = all chart bars available
input bool   InpAllow2026ModelAfter2026 = false;
input color  InpP15Color = clrLimeGreen;
input color  InpATRRankColor = clrDeepSkyBlue;
