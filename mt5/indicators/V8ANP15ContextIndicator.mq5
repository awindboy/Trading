enum ENUM_V8AN_MARK_MODE
{
   V8AN_MARK_LEVEL = 0,        // mark every completed M5 candle with P15 >= threshold
   V8AN_MARK_FRESH_CROSS = 1  // original fresh-cross style: prev < threshold, current >= threshold
};

