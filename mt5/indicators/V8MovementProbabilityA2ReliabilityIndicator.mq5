//+------------------------------------------------------------------+
double SafeLog1p(const double x)
{
   return MathLog(1.0 + MathMax(0.0,x));
}

double Clamp1e6(const double x)
{
   if(x>1.0e6) return 1.0e6;
   if(x<-1.0e6) return -1.0e6;
   return x;
}

int YearOf(const datetime t)
{
   MqlDateTime dt;
   if(!TimeToStruct(t,dt)) return 0;
   return dt.year;
}

int ModelForYear(const int year)
{
   if(year==2024) return 0;
   if(year==2025) return 1;
   if(year==2026) return 2;
   if(year>2026 && InpAllow2026ModelAfter2026) return 2;
   return -1;
}

bool PredictA2(const int year,const double &f[],double &p15,double &p30,double &p60)
{
   int m=ModelForYear(year);
   if(m<0 || ArraySize(f)!=V8A2_FEATURE_COUNT) return false;
   double z[V8A2_CLASS_COUNT];
   double maxz=-DBL_MAX;
   for(int cl=0;cl<V8A2_CLASS_COUNT;cl++)
   {
      double s=A2_INTERCEPT[m][cl];
      int base=cl*V8A2_FEATURE_COUNT;
      for(int j=0;j<V8A2_FEATURE_COUNT;j++)
      {
         double sc=A2_SCALE[m][j];
         if(MathAbs(sc)<1e-15) sc=1.0;
         double x=(f[j]-A2_MEAN[m][j])/sc;
         s += A2_COEF[m][base+j]*x;
      }
      z[cl]=s;
      if(s>maxz) maxz=s;
   }
   double e[V8A2_CLASS_COUNT];
   double den=0.0;
   for(int cl=0;cl<V8A2_CLASS_COUNT;cl++)
   {
      e[cl]=MathExp(z[cl]-maxz);
      den+=e[cl];
   }
   if(den<=0.0 || !MathIsValidNumber(den)) return false;
   for(int cl=0;cl<V8A2_CLASS_COUNT;cl++) e[cl]/=den;
   p15=e[0];
   p30=e[0]+e[1];
   p60=e[0]+e[1]+e[2];
   return true;
}

int FindLastRateBefore(const MqlRates &rates[],const datetime t)
{
   int n=ArraySize(rates);
   int lo=0,hi=n-1,ans=-1;
   while(lo<=hi)
   {
      int mid=(lo+hi)/2;
      if(rates[mid].time<t) { ans=mid; lo=mid+1; }
      else hi=mid-1;
   }
   return ans;
}

void ComputeRollingHL(const MqlRates &rates[],const int window,double &out[])
{
   int n=ArraySize(rates);
   ArrayResize(out,n);
   ArrayInitialize(out,EMPTY_VALUE);
   if(n<=0 || window<=0) return;
   int qmax[],qmin[];
   int cap=window+2;
   ArrayResize(qmax,cap);
   ArrayResize(qmin,cap);
   int hmax=0,cmax=0,hmin=0,cmin=0;
   for(int i=0;i<n;i++)
   {
      while(cmax>0)
      {
         int back=(hmax+cmax-1)%cap;
         if(rates[qmax[back]].high>rates[i].high) break;
         cmax--;
      }
      qmax[(hmax+cmax)%cap]=i; cmax++;
      while(cmax>0 && qmax[hmax]<=i-window) { hmax=(hmax+1)%cap; cmax--; }

      while(cmin>0)
      {
         int back=(hmin+cmin-1)%cap;
         if(rates[qmin[back]].low<rates[i].low) break;
         cmin--;
      }
      qmin[(hmin+cmin)%cap]=i; cmin++;
      while(cmin>0 && qmin[hmin]<=i-window) { hmin=(hmin+1)%cap; cmin--; }

      if(i>=window-1 && cmax>0 && cmin>0)
         out[i]=rates[qmax[hmax]].high-rates[qmin[hmin]].low;
   }
}

double PrefixWindow(const double &prefix[],const int pos,const int window)
{
   int left=pos+1-window;
   if(left<0) return EMPTY_VALUE;
   return prefix[pos+1]-prefix[left];
}

bool BuildHistoricalFeatureCaches(const MqlRates &m1[],
                                  double &psq[],double &prange[],double &pabs[],double &pbody[],double &ptick[],
                                  double &hl5[],double &hl15[],double &hl30[],double &hl60[],
                                  double &hl120[],double &hl240[],double &hl480[],double &hl1440[])
{
   int n=ArraySize(m1);
   if(n<1442) return false;
   ArrayResize(psq,n+1); ArrayResize(prange,n+1); ArrayResize(pabs,n+1); ArrayResize(pbody,n+1); ArrayResize(ptick,n+1);
   psq[0]=0.0; prange[0]=0.0; pabs[0]=0.0; pbody[0]=0.0; ptick[0]=0.0;
   for(int i=0;i<n;i++)
   {
      double dp=(i>0 ? m1[i].close-m1[i-1].close : 0.0);
      double rr=m1[i].high-m1[i].low;
      psq[i+1]=psq[i]+dp*dp;
      prange[i+1]=prange[i]+rr;
      pabs[i+1]=pabs[i]+MathAbs(dp);
      pbody[i+1]=pbody[i]+MathAbs(m1[i].close-m1[i].open);
      ptick[i+1]=ptick[i]+(double)m1[i].tick_volume;
   }
   ComputeRollingHL(m1,5,hl5); ComputeRollingHL(m1,15,hl15); ComputeRollingHL(m1,30,hl30); ComputeRollingHL(m1,60,hl60);
   ComputeRollingHL(m1,120,hl120); ComputeRollingHL(m1,240,hl240); ComputeRollingHL(m1,480,hl480); ComputeRollingHL(m1,1440,hl1440);
   return true;
}

double HLAt(const int wi,const int pos,
            const double &hl5[],const double &hl15[],const double &hl30[],const double &hl60[],
            const double &hl120[],const double &hl240[],const double &hl480[],const double &hl1440[])
{
   if(wi==0) return hl5[pos]; if(wi==1) return hl15[pos]; if(wi==2) return hl30[pos]; if(wi==3) return hl60[pos];
   if(wi==4) return hl120[pos]; if(wi==5) return hl240[pos]; if(wi==6) return hl480[pos]; return hl1440[pos];
}

bool BuildFeaturesCached(const MqlRates &m1[],const int pos,
                         const double &psq[],const double &prange[],const double &pabs[],const double &pbody[],const double &ptick[],
                         const double &hl5[],const double &hl15[],const double &hl30[],const double &hl60[],
                         const double &hl120[],const double &hl240[],const double &hl480[],const double &hl1440[],
                         double &f[])
{
   if(pos<1440 || pos>=ArraySize(m1)) return false;
   ArrayResize(f,V8A2_FEATURE_COUNT);
   double logrv[8],loghl[8],rvraw[8],hlraw[8],absraw[8],tickraw[8];
   int k=0;
   for(int wi=0;wi<8;wi++)
   {
      int w=V8A2_WINS[wi];
      double rv=PrefixWindow(psq,pos,w);
      double rs=PrefixWindow(prange,pos,w);
      double aa=PrefixWindow(pabs,pos,w);
      double bb=PrefixWindow(pbody,pos,w);
      double tk=PrefixWindow(ptick,pos,w);
      double hh=HLAt(wi,pos,hl5,hl15,hl30,hl60,hl120,hl240,hl480,hl1440);
      if(rv==EMPTY_VALUE || hh==EMPTY_VALUE || tk==EMPTY_VALUE) return false;
      rvraw[wi]=MathMax(0.0,rv); hlraw[wi]=MathMax(0.0,hh); absraw[wi]=MathMax(0.0,aa); tickraw[wi]=MathMax(0.0,tk);
      logrv[wi]=SafeLog1p(rvraw[wi]); loghl[wi]=SafeLog1p(hlraw[wi]);
      f[k++]=logrv[wi];
      f[k++]=SafeLog1p(rs);
      f[k++]=loghl[wi];
      f[k++]=SafeLog1p(aa);
      f[k++]=SafeLog1p(bb);
   }
   double rr=m1[pos].high-m1[pos].low;
   double dp=m1[pos].close-m1[pos-1].close;
   double tr=MathMax(rr,MathMax(MathAbs(m1[pos].high-m1[pos-1].close),MathAbs(m1[pos].low-m1[pos-1].close)));
   f[k++]=SafeLog1p(rr); f[k++]=SafeLog1p(tr); f[k++]=SafeLog1p(MathAbs(dp));
   f[k++]=logrv[0]-logrv[3]; f[k++]=loghl[0]-loghl[3];
   f[k++]=logrv[1]-logrv[4]; f[k++]=loghl[1]-loghl[4];
   f[k++]=logrv[2]-logrv[5]; f[k++]=loghl[2]-loghl[5];
   f[k++]=logrv[3]-logrv[6]; f[k++]=loghl[3]-loghl[6];
   f[k++]=logrv[4]-logrv[7]; f[k++]=loghl[4]-loghl[7];

   int ris[4]={1,3,5,7};
   for(int z=0;z<4;z++)
   {
      int wi=ris[z];
      int w=V8A2_WINS[wi];
      double hh=hlraw[wi], rvscale=MathSqrt(rvraw[wi]);
      f[k++]=Clamp1e6(10.0/(hh+1e-6));
      f[k++]=Clamp1e6(10.0/(rvscale+1e-6));
      f[k++]=Clamp1e6(hh/10.0);
      f[k++]=Clamp1e6(rvscale/10.0);
      f[k++]=Clamp1e6(tickraw[wi]/(double)w);
      f[k++]=Clamp1e6(absraw[wi]/(hh+1e-6));
   }
   int ps[3]={1,3,5};
   int pl[3]={5,7,7};
   for(int z=0;z<3;z++)
   {
      int a=ps[z],b=pl[z];
      double hratio=(hlraw[a]+1e-6)/(hlraw[b]+1e-6);
      double rvratio=(MathSqrt(rvraw[a])+1e-6)/(MathSqrt(rvraw[b])+1e-6);
      double tks=tickraw[a]/(double)V8A2_WINS[a], tkl=tickraw[b]/(double)V8A2_WINS[b];
      double tkratio=(tks+1e-6)/(tkl+1e-6);
      f[k++]=hratio; f[k++]=rvratio; f[k++]=tkratio;
   }
   return (k==V8A2_FEATURE_COUNT);
}

bool BuildFeaturesDirect(const datetime decision_time,double &f[])
{
   MqlRates m1[];
   datetime from=decision_time-(datetime)(30*86400);
   datetime to=decision_time-1;
   int copied=CopyRates(_Symbol,PERIOD_M1,from,to,m1);
   if(copied<1442) return false;
   int pos=ArraySize(m1)-1;
   if(m1[pos].time>=decision_time) pos--;
   if(pos<1440) return false;

   ArrayResize(f,V8A2_FEATURE_COUNT);
   double logrv[8],loghl[8],rvraw[8],hlraw[8],absraw[8],tickraw[8];
   int k=0;
   for(int wi=0;wi<8;wi++)
   {
      int w=V8A2_WINS[wi];
      int first=pos-w+1;
      if(first<1) return false;
      double rv=0.0,rs=0.0,aa=0.0,bb=0.0,tk=0.0,maxh=-DBL_MAX,minl=DBL_MAX;
      for(int i=first;i<=pos;i++)
      {
         double d=m1[i].close-m1[i-1].close;
         double r=m1[i].high-m1[i].low;
         rv+=d*d; rs+=r; aa+=MathAbs(d); bb+=MathAbs(m1[i].close-m1[i].open); tk+=(double)m1[i].tick_volume;
         if(m1[i].high>maxh) maxh=m1[i].high; if(m1[i].low<minl) minl=m1[i].low;
      }
      rvraw[wi]=MathMax(0.0,rv); hlraw[wi]=MathMax(0.0,maxh-minl); absraw[wi]=MathMax(0.0,aa); tickraw[wi]=MathMax(0.0,tk);
      logrv[wi]=SafeLog1p(rvraw[wi]); loghl[wi]=SafeLog1p(hlraw[wi]);
      f[k++]=logrv[wi]; f[k++]=SafeLog1p(rs); f[k++]=loghl[wi]; f[k++]=SafeLog1p(aa); f[k++]=SafeLog1p(bb);
   }
   double rr=m1[pos].high-m1[pos].low;
   double dp=m1[pos].close-m1[pos-1].close;
   double tr=MathMax(rr,MathMax(MathAbs(m1[pos].high-m1[pos-1].close),MathAbs(m1[pos].low-m1[pos-1].close)));
   f[k++]=SafeLog1p(rr); f[k++]=SafeLog1p(tr); f[k++]=SafeLog1p(MathAbs(dp));
   f[k++]=logrv[0]-logrv[3]; f[k++]=loghl[0]-loghl[3];
   f[k++]=logrv[1]-logrv[4]; f[k++]=loghl[1]-loghl[4];
   f[k++]=logrv[2]-logrv[5]; f[k++]=loghl[2]-loghl[5];
   f[k++]=logrv[3]-logrv[6]; f[k++]=loghl[3]-loghl[6];
   f[k++]=logrv[4]-logrv[7]; f[k++]=loghl[4]-loghl[7];

   int ris[4]={1,3,5,7};
   for(int z=0;z<4;z++)
   {
      int wi=ris[z],w=V8A2_WINS[wi];
      double hh=hlraw[wi],rvscale=MathSqrt(rvraw[wi]);
      f[k++]=Clamp1e6(10.0/(hh+1e-6));
      f[k++]=Clamp1e6(10.0/(rvscale+1e-6));
      f[k++]=Clamp1e6(hh/10.0);
      f[k++]=Clamp1e6(rvscale/10.0);
      f[k++]=Clamp1e6(tickraw[wi]/(double)w);
      f[k++]=Clamp1e6(absraw[wi]/(hh+1e-6));
   }
   int ps[3]={1,3,5},pl[3]={5,7,7};
   for(int z=0;z<3;z++)
   {
      int a=ps[z],b=pl[z];
      double tks=tickraw[a]/(double)V8A2_WINS[a],tkl=tickraw[b]/(double)V8A2_WINS[b];
      f[k++]=(hlraw[a]+1e-6)/(hlraw[b]+1e-6);
      f[k++]=(MathSqrt(rvraw[a])+1e-6)/(MathSqrt(rvraw[b])+1e-6);
      f[k++]=(tks+1e-6)/(tkl+1e-6);
   }
   return (k==V8A2_FEATURE_COUNT);
}

bool ComputeRanksForShift(const int shift,const int rates_total,const datetime &time[])
{
   Rank15Buffer[shift]=EMPTY_VALUE; Rank30Buffer[shift]=EMPTY_VALUE; Rank60Buffer[shift]=EMPTY_VALUE; ConsensusRankBuffer[shift]=EMPTY_VALUE;
   if(shift<1 || shift>=rates_total) return false;
   if(Prob15Buffer[shift]==EMPTY_VALUE || Prob30Buffer[shift]==EMPTY_VALUE || Prob60Buffer[shift]==EMPTY_VALUE) return false;
   int yr=YearOf(time[shift]+PeriodSeconds(PERIOD_M5));
   int c15=0,c30=0,c60=0,seen=0;
   for(int k=1;k<=V8A2_RANK_WINDOW;k++)
   {
      int j=shift+k;
      if(j>=rates_total) return false;
      if(YearOf(time[j]+PeriodSeconds(PERIOD_M5))!=yr) return false;
      if(Prob15Buffer[j]==EMPTY_VALUE || Prob30Buffer[j]==EMPTY_VALUE || Prob60Buffer[j]==EMPTY_VALUE) return false;
      if(Prob15Buffer[j]<=Prob15Buffer[shift]) c15++;
      if(Prob30Buffer[j]<=Prob30Buffer[shift]) c30++;
      if(Prob60Buffer[j]<=Prob60Buffer[shift]) c60++;
      seen++;
   }
   if(seen!=V8A2_RANK_WINDOW) return false;
   Rank15Buffer[shift]=100.0*(double)c15/(double)V8A2_RANK_WINDOW;
   Rank30Buffer[shift]=100.0*(double)c30/(double)V8A2_RANK_WINDOW;
   Rank60Buffer[shift]=100.0*(double)c60/(double)V8A2_RANK_WINDOW;
   ConsensusRankBuffer[shift]=MathMin(Rank15Buffer[shift],MathMin(Rank30Buffer[shift],Rank60Buffer[shift]));
   return true;
}

string StateName(const double r15,const double r30,const double r60)
{
   if(r15==EMPTY_VALUE || r30==EMPTY_VALUE || r60==EMPTY_VALUE) return "WARMUP";
   double mn=MathMin(r15,MathMin(r30,r60));
   double mx=MathMax(r15,MathMax(r30,r60));
   if(mn>=90.0) return "EXTREME";
   if(mn>=75.0) return "HIGH";
   if(mx<=25.0) return "QUIET";
   return "NORMAL";
}

void DeleteStatus()
{
   if(ObjectFind(0,V8A2_STATUS)>=0) ObjectDelete(0,V8A2_STATUS);
}

void UpdateStatus()
{
   if(!InpShowStatusLabel) { DeleteStatus(); return; }
   if(ObjectFind(0,V8A2_STATUS)<0)
   {
      if(!ObjectCreate(0,V8A2_STATUS,OBJ_LABEL,0,0,0)) return;
      ObjectSetInteger(0,V8A2_STATUS,OBJPROP_CORNER,InpStatusCorner);
      ObjectSetInteger(0,V8A2_STATUS,OBJPROP_XDISTANCE,InpStatusX);
      ObjectSetInteger(0,V8A2_STATUS,OBJPROP_YDISTANCE,InpStatusY);
      ObjectSetInteger(0,V8A2_STATUS,OBJPROP_ANCHOR,ANCHOR_RIGHT_UPPER);
      ObjectSetInteger(0,V8A2_STATUS,OBJPROP_COLOR,clrSilver);
      ObjectSetInteger(0,V8A2_STATUS,OBJPROP_FONTSIZE,9);
      ObjectSetString(0,V8A2_STATUS,OBJPROP_FONT,"Consolas");
      ObjectSetInteger(0,V8A2_STATUS,OBJPROP_SELECTABLE,false);
      ObjectSetInteger(0,V8A2_STATUS,OBJPROP_HIDDEN,true);
   }
   string txt="V8-A2 SHADOW | +/-10 | Direction NOT estimated";
   if(ArraySize(Prob15Buffer)>1 && Prob15Buffer[1]!=EMPTY_VALUE)
   {
      string state=StateName(Rank15Buffer[1],Rank30Buffer[1],Rank60Buffer[1]);
      txt+="\nP15="+DoubleToString(Prob15Buffer[1],1)+"%  P30="+DoubleToString(Prob30Buffer[1],1)+"%  P60="+DoubleToString(Prob60Buffer[1],1)+"%";
      if(Rank15Buffer[1]!=EMPTY_VALUE)
         txt+="\nR15="+DoubleToString(Rank15Buffer[1],1)+"  R30="+DoubleToString(Rank30Buffer[1],1)+"  R60="+DoubleToString(Rank60Buffer[1],1)+"  STATE="+state;
      else txt+="\nRank warmup: need prior 288 completed M5 states in same model year.";
   }
   txt+="\nState rules: EXTREME=all ranks>=90, HIGH=all>=75, QUIET=all<=25.";
   txt+="\nValidated claims apply to factual V8 events; continuous values elsewhere are context only.";
   ObjectSetString(0,V8A2_STATUS,OBJPROP_TEXT,txt);
}

bool RebuildHistory(const int rates_total,const datetime &time[])
{
   ArrayInitialize(Prob15Buffer,EMPTY_VALUE); ArrayInitialize(Prob30Buffer,EMPTY_VALUE); ArrayInitialize(Prob60Buffer,EMPTY_VALUE);
   ArrayInitialize(Rank15Buffer,EMPTY_VALUE); ArrayInitialize(Rank30Buffer,EMPTY_VALUE); ArrayInitialize(Rank60Buffer,EMPTY_VALUE); ArrayInitialize(ConsensusRankBuffer,EMPTY_VALUE);

   datetime cutoff=TimeCurrent()-(datetime)(MathMax(30,InpHistoryDays)*86400);
   int max_shift=rates_total-1;
   while(max_shift>1 && time[max_shift]<cutoff) max_shift--;
   max_shift=MathMin(rates_total-1,max_shift+V8A2_RANK_WINDOW+2);
   datetime oldest=time[max_shift]-(datetime)(30*86400);

   MqlRates m1[];
   int copied=CopyRates(_Symbol,PERIOD_M1,oldest,TimeCurrent(),m1);
   if(copied<1442) { Print("V8-A2: insufficient M1 history: ",copied); return false; }

   double psq[],prange[],pabs[],pbody[],ptick[];
   double hl5[],hl15[],hl30[],hl60[],hl120[],hl240[],hl480[],hl1440[];
   if(!BuildHistoricalFeatureCaches(m1,psq,prange,pabs,pbody,ptick,hl5,hl15,hl30,hl60,hl120,hl240,hl480,hl1440)) return false;

   double f[];
   for(int shift=max_shift;shift>=1;shift--)
   {
      datetime decision=time[shift]+PeriodSeconds(PERIOD_M5);
      int pos=FindLastRateBefore(m1,decision);
      if(!BuildFeaturesCached(m1,pos,psq,prange,pabs,pbody,ptick,hl5,hl15,hl30,hl60,hl120,hl240,hl480,hl1440,f)) continue;
      double p15,p30,p60;
      if(!PredictA2(YearOf(decision),f,p15,p30,p60)) continue;
      Prob15Buffer[shift]=100.0*p15; Prob30Buffer[shift]=100.0*p30; Prob60Buffer[shift]=100.0*p60;
   }
   for(int shift=max_shift;shift>=1;shift--) ComputeRanksForShift(shift,rates_total,time);
   return true;
}

void UpdateLatestClosedBar(const int rates_total,const datetime &time[])
{
   Prob15Buffer[0]=EMPTY_VALUE; Prob30Buffer[0]=EMPTY_VALUE; Prob60Buffer[0]=EMPTY_VALUE;
   Rank15Buffer[0]=EMPTY_VALUE; Rank30Buffer[0]=EMPTY_VALUE; Rank60Buffer[0]=EMPTY_VALUE; ConsensusRankBuffer[0]=EMPTY_VALUE;
   if(rates_total<2) return;
   datetime decision=time[1]+PeriodSeconds(PERIOD_M5);
   double f[],p15,p30,p60;
   if(!BuildFeaturesDirect(decision,f)) return;
   if(!PredictA2(YearOf(decision),f,p15,p30,p60)) return;
   Prob15Buffer[1]=100.0*p15; Prob30Buffer[1]=100.0*p30; Prob60Buffer[1]=100.0*p60;
   ComputeRanksForShift(1,rates_total,time);
}

int OnInit()
{
   if(_Period!=PERIOD_M5)
   {
      Print("V8-A2: attach to a GOLD M5 chart.");
      return INIT_PARAMETERS_INCORRECT;
   }
   SetIndexBuffer(0,Prob15Buffer,INDICATOR_DATA); SetIndexBuffer(1,Prob30Buffer,INDICATOR_DATA); SetIndexBuffer(2,Prob60Buffer,INDICATOR_DATA);
   SetIndexBuffer(3,Rank15Buffer,INDICATOR_DATA); SetIndexBuffer(4,Rank30Buffer,INDICATOR_DATA); SetIndexBuffer(5,Rank60Buffer,INDICATOR_DATA); SetIndexBuffer(6,ConsensusRankBuffer,INDICATOR_DATA);
   ArraySetAsSeries(Prob15Buffer,true); ArraySetAsSeries(Prob30Buffer,true); ArraySetAsSeries(Prob60Buffer,true);
   ArraySetAsSeries(Rank15Buffer,true); ArraySetAsSeries(Rank30Buffer,true); ArraySetAsSeries(Rank60Buffer,true); ArraySetAsSeries(ConsensusRankBuffer,true);
   PlotIndexSetInteger(0,PLOT_LINE_COLOR,InpColor15m); PlotIndexSetInteger(1,PLOT_LINE_COLOR,InpColor30m); PlotIndexSetInteger(2,PLOT_LINE_COLOR,InpColor60m);
   PlotIndexSetInteger(0,PLOT_LINE_WIDTH,MathMax(1,MathMin(5,InpLineWidth))); PlotIndexSetInteger(1,PLOT_LINE_WIDTH,MathMax(1,MathMin(5,InpLineWidth))); PlotIndexSetInteger(2,PLOT_LINE_WIDTH,MathMax(1,MathMin(5,InpLineWidth)));
   PlotIndexSetDouble(0,PLOT_EMPTY_VALUE,EMPTY_VALUE); PlotIndexSetDouble(1,PLOT_EMPTY_VALUE,EMPTY_VALUE); PlotIndexSetDouble(2,PLOT_EMPTY_VALUE,EMPTY_VALUE);
   IndicatorSetString(INDICATOR_SHORTNAME,"V8-A2 Movement Reliability SHADOW");
   IndicatorSetInteger(INDICATOR_DIGITS,1);
   DeleteStatus();
   return INIT_SUCCEEDED;
}

void OnDeinit(const int reason)
{
   DeleteStatus();
}

int OnCalculate(const int rates_total,const int prev_calculated,
                const datetime &time[],const double &open[],const double &high[],const double &low[],const double &close[],
                const long &tick_volume[],const long &volume[],const int &spread[])
{
   ArraySetAsSeries(time,true);
   if(rates_total<400) return 0;
   bool need_full=(!g_ready || prev_calculated==0);
   if(g_ready && time[0]==g_last_chart_bar && rates_total!=g_last_rates_total) need_full=true;
   if(need_full)
   {
      if(RebuildHistory(rates_total,time)) g_ready=true;
   }
   else if(time[0]!=g_last_chart_bar)
   {
      UpdateLatestClosedBar(rates_total,time);
   }
   g_last_chart_bar=time[0]; g_last_rates_total=rates_total;
   UpdateStatus();
   return rates_total;
}
