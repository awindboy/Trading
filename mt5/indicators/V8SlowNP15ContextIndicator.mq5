double SafeLog1p(const double x)
{
   return MathLog(1.0 + MathMax(0.0,x));
}

double Clamp1e6(const double x)
{
   if(x>1.0e6) return 1.0e6;
   if(x<-1.0e6) return -1.0e6;
   return x;
}

int YearOf(const datetime t)
{
   MqlDateTime dt;
   if(!TimeToStruct(t,dt)) return 0;
   return dt.year;
}

int ModelForYear(const int year)
{
   if(year==2024) return 0;
   if(year==2025) return 1;
   if(year==2026) return 2;
   if(year>2026 && InpAllow2026ModelAfter2026) return 2;
   return -1;
}

bool PredictV8AN(const int year,const double &f[],double &p15)
{
   int m=ModelForYear(year);
   if(m<0 || ArraySize(f)!=V8AN_FEATURE_COUNT) return false;

   double z[V8AN_CLASS_COUNT];
   double maxz=-DBL_MAX;

   for(int cl=0;cl<V8AN_CLASS_COUNT;cl++)
   {
      double s=V8AN_INTERCEPT[m][cl];
      int base=cl*V8AN_FEATURE_COUNT;
      for(int j=0;j<V8AN_FEATURE_COUNT;j++)
      {
         double sc=V8AN_SCALE[m][j];
         if(MathAbs(sc)<1e-15) sc=1.0;
         double x=(f[j]-V8AN_MEAN[m][j])/sc;
         s += V8AN_COEF[m][base+j]*x;
      }
      z[cl]=s;
      if(s>maxz) maxz=s;
   }

   double den=0.0;
   double e[V8AN_CLASS_COUNT];
   for(int cl=0;cl<V8AN_CLASS_COUNT;cl++)
   {
      e[cl]=MathExp(z[cl]-maxz);
      den+=e[cl];
   }
   if(den<=0.0 || !MathIsValidNumber(den)) return false;

   for(int cl=0;cl<V8AN_CLASS_COUNT;cl++) e[cl]/=den;

   // A2-style survival class mapping retained by the Slow-N probe:
   // class 0 = reached by 15m; class 1 = 15-30m; class 2 = 30-60m; class 3 = not by 60m.
   p15=e[0];
   return MathIsValidNumber(p15);
}

int FindLastRateBefore(const MqlRates &rates[],const datetime t)
{
   int n=ArraySize(rates);
   int lo=0,hi=n-1,ans=-1;
   while(lo<=hi)
   {
      int mid=(lo+hi)/2;
      if(rates[mid].time<t) { ans=mid; lo=mid+1; }
      else hi=mid-1;
   }
   return ans;
}

void ComputeRollingHL(const MqlRates &rates[],const int window,double &out[])
{
   int n=ArraySize(rates);
   ArrayResize(out,n);
   ArrayInitialize(out,EMPTY_VALUE);
   if(n<=0 || window<=0) return;

   int qmax[],qmin[];
   int cap=window+2;
   ArrayResize(qmax,cap);
   ArrayResize(qmin,cap);
   int hmax=0,cmax=0,hmin=0,cmin=0;

   for(int i=0;i<n;i++)
   {
      while(cmax>0)
      {
         int back=(hmax+cmax-1)%cap;
         if(rates[qmax[back]].high>rates[i].high) break;
         cmax--;
      }
      qmax[(hmax+cmax)%cap]=i; cmax++;
      while(cmax>0 && qmax[hmax]<=i-window) { hmax=(hmax+1)%cap; cmax--; }

      while(cmin>0)
      {
         int back=(hmin+cmin-1)%cap;
         if(rates[qmin[back]].low<rates[i].low) break;
         cmin--;
      }
      qmin[(hmin+cmin)%cap]=i; cmin++;
      while(cmin>0 && qmin[hmin]<=i-window) { hmin=(hmin+1)%cap; cmin--; }

      if(i>=window-1 && cmax>0 && cmin>0)
         out[i]=rates[qmax[hmax]].high-rates[qmin[hmin]].low;
   }
}

double PrefixWindow(const double &prefix[],const int pos,const int window)
{
   int left=pos+1-window;
   if(left<0) return EMPTY_VALUE;
   return prefix[pos+1]-prefix[left];
}

bool BuildHistoricalFeatureCaches(const MqlRates &m1[],
                                  double &psq[],double &prange[],double &pabs[],double &pbody[],double &ptick[],
                                  double &hl5[],double &hl15[],double &hl30[],double &hl60[],
                                  double &hl120[],double &hl240[],double &hl480[],double &hl1440[])
{
   int n=ArraySize(m1);
   if(n<1442) return false;

   ArrayResize(psq,n+1);
   ArrayResize(prange,n+1);
   ArrayResize(pabs,n+1);
   ArrayResize(pbody,n+1);
   ArrayResize(ptick,n+1);

   psq[0]=0.0; prange[0]=0.0; pabs[0]=0.0; pbody[0]=0.0; ptick[0]=0.0;

   for(int i=0;i<n;i++)
   {
      double dp=(i>0 ? m1[i].close-m1[i-1].close : 0.0);
      double rr=m1[i].high-m1[i].low;
      psq[i+1]=psq[i]+dp*dp;
      prange[i+1]=prange[i]+rr;
      pabs[i+1]=pabs[i]+MathAbs(dp);
      pbody[i+1]=pbody[i]+MathAbs(m1[i].close-m1[i].open);
      ptick[i+1]=ptick[i]+(double)m1[i].tick_volume;
   }

   ComputeRollingHL(m1,5,hl5);
   ComputeRollingHL(m1,15,hl15);
   ComputeRollingHL(m1,30,hl30);
   ComputeRollingHL(m1,60,hl60);
   ComputeRollingHL(m1,120,hl120);
   ComputeRollingHL(m1,240,hl240);
   ComputeRollingHL(m1,480,hl480);
   ComputeRollingHL(m1,1440,hl1440);
   return true;
}

double HLAt(const int wi,const int pos,
            const double &hl5[],const double &hl15[],const double &hl30[],const double &hl60[],
            const double &hl120[],const double &hl240[],const double &hl480[],const double &hl1440[])
{
   if(wi==0) return hl5[pos];
   if(wi==1) return hl15[pos];
   if(wi==2) return hl30[pos];
   if(wi==3) return hl60[pos];
   if(wi==4) return hl120[pos];
   if(wi==5) return hl240[pos];
   if(wi==6) return hl480[pos];
   return hl1440[pos];
}


bool BuildFeaturesCached(const MqlRates &m1[],const int pos,const double barrier,
                         const double &psq[],const double &prange[],const double &pabs[],const double &pbody[],const double &ptick[],
                         const double &hl5[],const double &hl15[],const double &hl30[],const double &hl60[],
                         const double &hl120[],const double &hl240[],const double &hl480[],const double &hl1440[],
                         double &f[])
{
   if(pos<1440 || pos>=ArraySize(m1) || !MathIsValidNumber(barrier) || barrier<=0.0) return false;

   ArrayResize(f,V8AN_FEATURE_COUNT);
   double logrv[8],loghl[8],rvraw[8],hlraw[8],absraw[8],tickraw[8];
   int k=0;

   for(int wi=0;wi<8;wi++)
   {
      int w=V8AN_WINS[wi];
      double rv=PrefixWindow(psq,pos,w);
      double rs=PrefixWindow(prange,pos,w);
      double aa=PrefixWindow(pabs,pos,w);
      double bb=PrefixWindow(pbody,pos,w);
      double tk=PrefixWindow(ptick,pos,w);
      double hh=HLAt(wi,pos,hl5,hl15,hl30,hl60,hl120,hl240,hl480,hl1440);

      if(rv==EMPTY_VALUE || hh==EMPTY_VALUE || tk==EMPTY_VALUE) return false;

      rvraw[wi]=MathMax(0.0,rv);
      hlraw[wi]=MathMax(0.0,hh);
      absraw[wi]=MathMax(0.0,aa);
      tickraw[wi]=MathMax(0.0,tk);
      logrv[wi]=SafeLog1p(rvraw[wi]);
      loghl[wi]=SafeLog1p(hlraw[wi]);

      f[k++]=logrv[wi];
      f[k++]=SafeLog1p(rs);
      f[k++]=loghl[wi];
      f[k++]=SafeLog1p(aa);
      f[k++]=SafeLog1p(bb);
   }

   double rr=m1[pos].high-m1[pos].low;
   double dp=m1[pos].close-m1[pos-1].close;
   double tr=MathMax(rr,MathMax(MathAbs(m1[pos].high-m1[pos-1].close),MathAbs(m1[pos].low-m1[pos-1].close)));

   f[k++]=SafeLog1p(rr);
   f[k++]=SafeLog1p(tr);
   f[k++]=SafeLog1p(MathAbs(dp));

   f[k++]=logrv[0]-logrv[3];
   f[k++]=loghl[0]-loghl[3];
   f[k++]=logrv[1]-logrv[4];
   f[k++]=loghl[1]-loghl[4];
   f[k++]=logrv[2]-logrv[5];
   f[k++]=loghl[2]-loghl[5];
   f[k++]=logrv[3]-logrv[6];
   f[k++]=loghl[3]-loghl[6];
   f[k++]=logrv[4]-logrv[7];
   f[k++]=loghl[4]-loghl[7];

   // Slow-N barrier-difficulty features.
   // barrier is fixed for the H4 decision block:
   // 0.25 * Wilder ATR14 from the immediately previous completed H4 bar.
   int ris[4]={1,3,5,7};
   for(int z=0;z<4;z++)
   {
      int wi=ris[z];
      int w=V8AN_WINS[wi];
      double hh=hlraw[wi];
      double rvscale=MathSqrt(rvraw[wi]);

      f[k++]=Clamp1e6(barrier/(hh+1e-6));
      f[k++]=Clamp1e6(barrier/(rvscale+1e-6));
      f[k++]=Clamp1e6(hh/(barrier+1e-6));
      f[k++]=Clamp1e6(rvscale/(barrier+1e-6));
      f[k++]=Clamp1e6(tickraw[wi]/(double)w);
      f[k++]=Clamp1e6(absraw[wi]/(hh+1e-6));
   }

   int ps[3]={1,3,5};
   int pl[3]={5,7,7};

   for(int z=0;z<3;z++)
   {
      int a=ps[z],b=pl[z];
      double hratio=(hlraw[a]+1e-6)/(hlraw[b]+1e-6);
      double rvratio=(MathSqrt(rvraw[a])+1e-6)/(MathSqrt(rvraw[b])+1e-6);
      double tks=tickraw[a]/(double)V8AN_WINS[a];
      double tkl=tickraw[b]/(double)V8AN_WINS[b];
      double tkratio=(tks+1e-6)/(tkl+1e-6);

      f[k++]=hratio;
      f[k++]=rvratio;
      f[k++]=tkratio;
   }

   return (k==V8AN_FEATURE_COUNT);
}

bool BuildAtrCache(const ENUM_TIMEFRAMES tf,const datetime from,const datetime to,MqlRates &rates[],double &atr[])
{
   int copied=CopyRates(_Symbol,tf,from,to,rates);
   if(copied<30) return false;
   ArraySetAsSeries(rates,false);

   int n=ArraySize(rates);
   ArrayResize(atr,n);
   ArrayInitialize(atr,EMPTY_VALUE);

   double tr[];
   ArrayResize(tr,n);

   for(int i=0;i<n;i++)
   {
      double rr=rates[i].high-rates[i].low;
      if(i==0)
         tr[i]=rr;
      else
         tr[i]=MathMax(rr,MathMax(MathAbs(rates[i].high-rates[i-1].close),MathAbs(rates[i].low-rates[i-1].close)));
   }

   double seed=0.0;
   for(int i=0;i<14;i++) seed+=tr[i];
   atr[13]=seed/14.0;

   for(int i=14;i<n;i++)
      atr[i]=(atr[i-1]*13.0+tr[i])/14.0;

   return true;
}

int FindLastRateAtOrBefore(const MqlRates &rates[],const datetime t)
{
   int n=ArraySize(rates);
   int lo=0,hi=n-1,ans=-1;
   while(lo<=hi)
   {
      int mid=(lo+hi)/2;
      if(rates[mid].time<=t) { ans=mid; lo=mid+1; }
      else hi=mid-1;
   }
   return ans;
}

// Target alignment is decision-block based, not source-M5-open based.
// Example: source M5 11:55 -> decision 12:00 belongs to H4 block starting 12:00,
// so use ATR14 from the H4 bar that ended at 12:00 (the immediately previous H4 bar).
bool SlowScaleForDecision(const datetime decision,const MqlRates &h4[],const double &atr[],
                          double &h4_atr,double &target,int &prev_h4_index)
{
   int current_h4=FindLastRateAtOrBefore(h4,decision);
   int prev=current_h4-1;
   if(prev<0 || prev>=ArraySize(atr)) return false;

   double a=atr[prev];
   if(a==EMPTY_VALUE || !MathIsValidNumber(a) || a<=0.0) return false;

   h4_atr=a;
   target=V8AN_SLOW_TARGET_MULT*a;
   prev_h4_index=prev;
   return (MathIsValidNumber(target) && target>0.0);
}

double H4ATRPercentileRankPrior(const double current,const int prev_h4_index,const int lookback,const double &atr[])
{
   if(!MathIsValidNumber(current) || current<=0.0 || lookback<=0) return EMPTY_VALUE;
   if(prev_h4_index-lookback<0) return EMPTY_VALUE;

   int count=0,seen=0;
   for(int i=prev_h4_index-lookback;i<prev_h4_index;i++)
   {
      double v=atr[i];
      if(v==EMPTY_VALUE || !MathIsValidNumber(v) || v<=0.0) return EMPTY_VALUE;
      if(v<=current) count++;
      seen++;
   }
   if(seen!=lookback) return EMPTY_VALUE;
   return 100.0*(double)count/(double)lookback;
}

double SMA20AtShift(const int shift,const int rates_total,const double &close[])
{
   if(shift<1 || shift+19>=rates_total) return EMPTY_VALUE;
   double sum=0.0;
   for(int j=0;j<20;j++) sum+=close[shift+j];
   return sum/20.0;
}

double PercentileRankPrior(const double current,const int shift,const int lookback,const int rates_total,const double &raw[])
{
   if(current==EMPTY_VALUE || !MathIsValidNumber(current) || lookback<=0) return EMPTY_VALUE;
   if(shift+lookback>=rates_total) return EMPTY_VALUE;

   int count=0,seen=0;
   for(int k=1;k<=lookback;k++)
   {
      double v=raw[shift+k];
      if(v==EMPTY_VALUE || !MathIsValidNumber(v)) return EMPTY_VALUE;
      if(v<=current) count++;
      seen++;
   }
   if(seen!=lookback) return EMPTY_VALUE;
   return 100.0*(double)count/(double)lookback;
}


void DeleteMarkers()
{
   ObjectsDeleteAll(0,V8SLOW_MARK_PREFIX,0,OBJ_ARROW_DOWN);
}

void CreateCandleMarker(const datetime t,const double hi,const double lo)
{
   string name=V8SLOW_MARK_PREFIX+IntegerToString((long)t);
   datetime center=t+PeriodSeconds(PERIOD_M5)/2;
   double offset=MathMax((hi-lo)*0.20,(double)MathMax(1,InpMarkerOffsetPoints)*_Point);
   double price=hi+offset;

   if(ObjectFind(0,name)>=0) return;
   if(!ObjectCreate(0,name,OBJ_ARROW_DOWN,0,center,price)) return;

   ObjectSetInteger(0,name,OBJPROP_COLOR,InpMarkerColor);
   ObjectSetInteger(0,name,OBJPROP_WIDTH,MathMax(1,InpMarkerWidth));
   ObjectSetInteger(0,name,OBJPROP_ANCHOR,ANCHOR_BOTTOM);
   ObjectSetInteger(0,name,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,name,OBJPROP_SELECTED,false);
   ObjectSetInteger(0,name,OBJPROP_HIDDEN,true);
}

void RebuildMarkers(const int rates_total,const datetime &time[],const double &high[],const double &low[])
{
   DeleteMarkers();
   if(!InpMarkCandles) return;

   int maxbars=MathMin(InpMarkerHistoryBars,rates_total-2);
   if(maxbars<1) return;

   for(int shift=maxbars;shift>=1;shift--)
   {
      double p=P15Buffer[shift];
      if(p==EMPTY_VALUE || !MathIsValidNumber(p)) continue;

      bool pass=false;
      if(InpMarkMode==SLOWN_MARK_LEVEL)
      {
         pass=(p>=InpP15Threshold);
      }
      else
      {
         if(shift+1<rates_total)
         {
            double prev=P15Buffer[shift+1];
            pass=(prev!=EMPTY_VALUE && MathIsValidNumber(prev) && prev<InpP15Threshold && p>=InpP15Threshold);
         }
      }

      if(pass) CreateCandleMarker(time[shift],high[shift],low[shift]);
   }
}


int OnInit()
{
   if(_Period!=PERIOD_M5)
   {
      Print("V8SlowNP15ContextIndicator: attach to an M5 chart only.");
      return INIT_FAILED;
   }

   if(InpP15Threshold<0.0 || InpP15Threshold>100.0 ||
      InpH4ATRRankLookback<2 || InpDistanceRankLookback<2)
      return INIT_PARAMETERS_INCORRECT;

   SetIndexBuffer(0,P15Buffer,INDICATOR_DATA);
   SetIndexBuffer(1,H4ATRRankBuffer,INDICATOR_DATA);
   SetIndexBuffer(2,DistanceRankBuffer,INDICATOR_DATA);
   SetIndexBuffer(3,H4ATRRawBuffer,INDICATOR_CALCULATIONS);
   SetIndexBuffer(4,SlowTargetRawBuffer,INDICATOR_CALCULATIONS);
   SetIndexBuffer(5,DistanceRawBuffer,INDICATOR_CALCULATIONS);

   ArraySetAsSeries(P15Buffer,true);
   ArraySetAsSeries(H4ATRRankBuffer,true);
   ArraySetAsSeries(DistanceRankBuffer,true);
   ArraySetAsSeries(H4ATRRawBuffer,true);
   ArraySetAsSeries(SlowTargetRawBuffer,true);
   ArraySetAsSeries(DistanceRawBuffer,true);

   PlotIndexSetInteger(0,PLOT_LINE_COLOR,InpP15Color);
   PlotIndexSetInteger(0,PLOT_LINE_WIDTH,MathMax(1,InpP15Width));
   PlotIndexSetInteger(1,PLOT_LINE_COLOR,InpH4ATRRankColor);
   PlotIndexSetInteger(1,PLOT_LINE_WIDTH,MathMax(1,InpContextWidth));
   PlotIndexSetInteger(2,PLOT_LINE_COLOR,InpDistanceRankColor);
   PlotIndexSetInteger(2,PLOT_LINE_WIDTH,MathMax(1,InpContextWidth));

   IndicatorSetInteger(INDICATOR_LEVELS,1);
   IndicatorSetDouble(INDICATOR_LEVELVALUE,0,InpP15Threshold);
   IndicatorSetInteger(INDICATOR_LEVELCOLOR,0,InpMarkerColor);
   IndicatorSetInteger(INDICATOR_LEVELSTYLE,0,STYLE_DASH);
   IndicatorSetInteger(INDICATOR_LEVELWIDTH,0,1);

   IndicatorSetString(INDICATOR_SHORTNAME,
      StringFormat("V8 Slow-N P15 PROBE | H4x0.25 | threshold %.1f",InpP15Threshold));

   DeleteMarkers();
   g_last_closed_m5=0;
   return INIT_SUCCEEDED;
}

void OnDeinit(const int reason)
{
   DeleteMarkers();
}

int OnCalculate(const int rates_total,const int prev_calculated,
                const datetime &time[],const double &open[],const double &high[],const double &low[],const double &close[],
                const long &tick_volume[],const long &volume[],const int &spread[])
{
   ArraySetAsSeries(time,true);
   ArraySetAsSeries(open,true);
   ArraySetAsSeries(high,true);
   ArraySetAsSeries(low,true);
   ArraySetAsSeries(close,true);

   int minbars=MathMax(InpDistanceRankLookback+30,60);
   if(rates_total<minbars) return 0;

   // All inputs are completed-bar inputs. Recompute only when a new M5 bar opens.
   if(prev_calculated>0 && g_last_closed_m5==time[1])
      return rates_total;

   ArrayInitialize(P15Buffer,EMPTY_VALUE);
   ArrayInitialize(H4ATRRankBuffer,EMPTY_VALUE);
   ArrayInitialize(DistanceRankBuffer,EMPTY_VALUE);
   ArrayInitialize(H4ATRRawBuffer,EMPTY_VALUE);
   ArrayInitialize(SlowTargetRawBuffer,EMPTY_VALUE);
   ArrayInitialize(DistanceRawBuffer,EMPTY_VALUE);

   P15Buffer[0]=EMPTY_VALUE;
   H4ATRRankBuffer[0]=EMPTY_VALUE;
   DistanceRankBuffer[0]=EMPTY_VALUE;

   int display_max=rates_total-2;
   if(InpHistoryBars>0) display_max=MathMin(display_max,InpHistoryBars);
   if(display_max<1) return 0;

   int compute_max=MathMin(rates_total-2,display_max+InpDistanceRankLookback+25);

   datetime earliest_source=time[compute_max];
   datetime latest_decision=time[1]+PeriodSeconds(PERIOD_M5);

   // M1 feature warm-up for the 1440-minute feature family.
   datetime m1_from=earliest_source-(datetime)(45*86400);
   datetime m1_to=latest_decision-1;

   MqlRates m1[];
   int copied_m1=CopyRates(_Symbol,PERIOD_M1,m1_from,m1_to,m1);
   if(copied_m1<1600)
   {
      Print("V8SlowNP15ContextIndicator: insufficient M1 history: ",copied_m1);
      return 0;
   }
   ArraySetAsSeries(m1,false);

   double psq[],prange[],pabs[],pbody[],ptick[];
   double hl5[],hl15[],hl30[],hl60[],hl120[],hl240[],hl480[],hl1440[];

   if(!BuildHistoricalFeatureCaches(m1,psq,prange,pabs,pbody,ptick,
                                    hl5,hl15,hl30,hl60,hl120,hl240,hl480,hl1440))
      return 0;

   // Load enough H4 history for Wilder ATR seed plus the requested H4 percentile lookback.
   long dynamic_h4_seconds=(long)(InpH4ATRRankLookback+80)*8*3600;
   long min_h4_seconds=(long)120*86400;
   long h4_warmup_seconds=(dynamic_h4_seconds>min_h4_seconds ? dynamic_h4_seconds : min_h4_seconds);

   MqlRates h4[];
   double h4atr[];
   datetime h4_from=earliest_source-(datetime)h4_warmup_seconds;
   datetime h4_to=latest_decision+PeriodSeconds(PERIOD_H4);

   if(!BuildAtrCache(PERIOD_H4,h4_from,h4_to,h4,h4atr))
   {
      Print("V8SlowNP15ContextIndicator: insufficient H4 history for ATR cache.");
      return 0;
   }

   // Context raw series. Slow target is determined from DECISION time H4 block.
   for(int shift=compute_max;shift>=1;shift--)
   {
      datetime decision=time[shift]+PeriodSeconds(PERIOD_M5);
      double a,t;
      int prev_h4=-1;
      if(!SlowScaleForDecision(decision,h4,h4atr,a,t,prev_h4))
         continue;

      H4ATRRawBuffer[shift]=a;
      SlowTargetRawBuffer[shift]=t;

      if(InpShowH4ATRRank)
         H4ATRRankBuffer[shift]=H4ATRPercentileRankPrior(a,prev_h4,InpH4ATRRankLookback,h4atr);

      double sma20=SMA20AtShift(shift,rates_total,close);
      if(sma20!=EMPTY_VALUE && t>0.0)
         DistanceRawBuffer[shift]=MathAbs(close[shift]-sma20)/t;
   }

   // P15. Compute one extra prior bar so fresh-cross mode has a prior score.
   int pmax=MathMin(compute_max,display_max+1);
   double f[];

   for(int shift=pmax;shift>=1;shift--)
   {
      datetime decision=time[shift]+PeriodSeconds(PERIOD_M5);
      int pos=FindLastRateBefore(m1,decision);
      double target=SlowTargetRawBuffer[shift];
      if(pos<0 || target==EMPTY_VALUE || !MathIsValidNumber(target) || target<=0.0) continue;

      if(!BuildFeaturesCached(m1,pos,target,
                              psq,prange,pabs,pbody,ptick,
                              hl5,hl15,hl30,hl60,hl120,hl240,hl480,hl1440,f))
         continue;

      double p15;
      if(!PredictV8AN(YearOf(decision),f,p15)) continue;
      P15Buffer[shift]=100.0*p15;
   }

   for(int shift=display_max;shift>=1;shift--)
   {
      if(InpShowDistanceRank)
         DistanceRankBuffer[shift]=PercentileRankPrior(DistanceRawBuffer[shift],shift,InpDistanceRankLookback,rates_total,DistanceRawBuffer);
   }

   RebuildMarkers(rates_total,time,high,low);
   g_last_closed_m5=time[1];
   ChartRedraw(0);

   return rates_total;
}
