//+------------------------------------------------------------------+
//| V8SlowNP15ContextIndicator.mq5                                   |
//| V8-A-N-SLOW H4-scale P15 PROBE + causal context ranks            |
//| Phase-0 86-feature model embedded; NO PRODUCTION AUTHORITY       |
//+------------------------------------------------------------------+
#property strict
#property version   "0.20"
#property description "Research-only V8-A-N-SLOW Phase-0 probe. P15 for T=0.25*previous-completed H4 ATR14, H4 ATR rank, MA20-distance/slow-target rank. Direction NOT estimated."
#property indicator_separate_window
#property indicator_buffers 6
#property indicator_plots   3
#property indicator_minimum 0.0
#property indicator_maximum 100.0

#property indicator_label1  "Slow-N P15 (0.25 H4 ATR)"
#property indicator_type1   DRAW_LINE
#property indicator_color1  clrLimeGreen
#property indicator_width1  2

#property indicator_label2  "H4 ATR14 Rank"
#property indicator_type2   DRAW_LINE
#property indicator_color2  clrDeepSkyBlue
#property indicator_width2  1

#property indicator_label3  "MA20 Distance/SlowTarget Rank"
#property indicator_type3   DRAW_LINE
#property indicator_color3  clrOrange
#property indicator_width3  1

enum ENUM_SLOWN_MARK_MODE
{
   SLOWN_MARK_LEVEL = 0,        // mark every completed M5 candle with P15 >= threshold
   SLOWN_MARK_FRESH_CROSS = 1  // previous completed M5 P15 < threshold, current >= threshold
};

input group "Probability / Marker"
input double InpP15Threshold = 75.0;
input ENUM_SLOWN_MARK_MODE InpMarkMode = SLOWN_MARK_LEVEL;
input bool   InpMarkCandles = true;
input color  InpMarkerColor = clrMagenta;
input int    InpMarkerWidth = 2;
input int    InpMarkerHistoryBars = 5000;
input int    InpMarkerOffsetPoints = 100;

input group "Context 0-100 Ranks"
input int    InpH4ATRRankLookback = 288;        // completed H4 bars
input int    InpDistanceRankLookback = 288;     // completed M5 bars
input bool   InpShowH4ATRRank = true;
input bool   InpShowDistanceRank = true;

input group "Display / Safety"
input int    InpHistoryBars = 20000;            // 0 = all chart bars available
input bool   InpAllow2026ModelAfter2026 = false;
input color  InpP15Color = clrLimeGreen;
input color  InpH4ATRRankColor = clrDeepSkyBlue;
input color  InpDistanceRankColor = clrOrange;
input int    InpP15Width = 2;
input int    InpContextWidth = 1;

#define V8AN_FEATURE_COUNT 86
#define V8AN_MODEL_COUNT 3
#define V8AN_CLASS_COUNT 4
const double V8AN_SLOW_TARGET_MULT = 0.25;
const int V8AN_WINS[8] = {5,15,30,60,120,240,480,1440};

double P15Buffer[];
double H4ATRRankBuffer[];
double DistanceRankBuffer[];
double H4ATRRawBuffer[];
double SlowTargetRawBuffer[];
double DistanceRawBuffer[];

string V8SLOW_MARK_PREFIX = "V8SLOW_P15_MARK_";
datetime g_last_closed_m5 = 0;

