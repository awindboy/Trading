    {
      "start": 545.6,
      "duration": 3.0,
      "text": "잡았잖아요."
    },
    {
      "start": 552.0,
      "duration": 4.2,
      "text": "그래서 다 지울게요."
    },
    {
      "start": 557.6,
      "duration": 2.6,
      "text": "익절했던"
