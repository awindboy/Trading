    {
      "start": 610.3,
      "duration": 4.9,
      "text": "줘서 50% 안에 있죠."
    },
    {
      "start": 618.6,
      "duration": 5.1,
      "text": "여기서 다른 타임프레임으로 넘어가서\n다시"
