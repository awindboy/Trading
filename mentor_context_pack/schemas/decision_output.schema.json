{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mentor-decision-output.schema.json",
  "title": "Mentor MTF decision output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "decision_id", "as_of", "symbol", "action",
    "data_integrity", "scenario", "evidence", "order", "reason"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "decision_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "symbol": {"type": "string", "minLength": 1},
    "action": {
      "enum": ["DATA_ERROR", "NO_TRADE", "WAIT", "PREPARE", "ARM", "ORDER", "CANCEL", "MISSED", "HOLD"]
    },
    "data_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "common_as_of", "future_hidden", "issues"],
      "properties": {
        "passed": {"type": "boolean"},
        "common_as_of": {"type": "boolean"},
        "future_hidden": {"type": "boolean"},
        "issues": {"type": "array", "items": {"type": "string"}}
      }
    },
    "scenario": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "scenario_id", "direction", "scope", "active_range", "pd_location",
        "objective", "closer_liquidity_review", "root_ob", "refinement_path",
        "source_invalidation", "last_h1_reauthorized_at", "last_m15_reauthorized_at"
      ],
      "properties": {
        "scenario_id": {"type": "string"},
        "direction": {"enum": ["LONG", "SHORT"]},
        "scope": {"enum": ["EXTERNAL_CONTINUATION", "INTERNAL_ROTATION", "EXTERNAL_REVERSAL"]},
        "active_range": {"$ref": "#/$defs/priceRange"},
        "pd_location": {"enum": ["PREMIUM", "DISCOUNT", "EQ"]},
        "objective": {"$ref": "#/$defs/objective"},
        "closer_liquidity_review": {"type": "string", "minLength": 1},
        "root_ob": {"$ref": "#/$defs/zone"},
        "refinement_path": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/zone"}},
        "source_invalidation": {"type": "number"},
        "last_h1_reauthorized_at": {"type": "string", "format": "date-time"},
        "last_m15_reauthorized_at": {"type": "string", "format": "date-time"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["refined_ob_touch", "mature_sweep", "meaningful_choch", "execution_zone", "files"],
      "properties": {
        "refined_ob_touch": {"type": ["string", "null"]},
        "mature_sweep": {"type": ["string", "null"]},
        "meaningful_choch": {"type": ["string", "null"]},
        "execution_zone": {"anyOf": [{"$ref": "#/$defs/zone"}, {"type": "null"}]},
        "files": {"type": "array", "items": {"type": "string"}}
      }
    },
    "order": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "execution_model", "entry", "hard_sl", "tp", "actual_spread",
        "broker_stops_level", "risk_mode"
      ],
      "properties": {
        "execution_model": {"enum": ["HTF_OB_REACTION", "DELIVERY_FVG_REPLACEMENT", "DELIVERY_FVG_ADDON"]},
        "entry": {"type": "number"},
        "hard_sl": {"type": "number"},
        "tp": {"type": "number"},
        "actual_spread": {"type": "number", "minimum": 0},
        "broker_stops_level": {"type": "number", "minimum": 0},
        "risk_mode": {"enum": ["MIN_LOT", "FIXED_RISK"]}
      }
    },
    "reason": {"type": "string", "minLength": 1},
    "confidence": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]}
  },
  "$defs": {
    "priceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "high", "eq"],
      "properties": {
        "low": {"type": "number"},
        "high": {"type": "number"},
        "eq": {"type": "number"}
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "price", "source_tf", "source_time", "consumed"],
      "properties": {
        "type": {"enum": ["EXTERNAL_LIQUIDITY", "INTERNAL_LIQUIDITY"]},
        "price": {"type": "number"},
        "source_tf": {"enum": ["H1", "M30", "M15", "M5", "M1"]},
        "source_time": {"type": "string", "format": "date-time"},
        "consumed": {"const": false}
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "tf", "time", "low", "high", "direction", "causal_reason"],
      "properties": {
        "kind": {"enum": ["OB", "FVG"]},
        "tf": {"enum": ["H1", "M30", "M15", "M5", "M1"]},
        "time": {"type": "string", "format": "date-time"},
        "low": {"type": "number"},
        "high": {"type": "number"},
        "direction": {"enum": ["BULLISH", "BEARISH"]},
        "causal_reason": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "ORDER"}}},
      "then": {
        "properties": {
          "scenario": {"type": "object"},
          "order": {"type": "object"}
        }
      }
    }
  ]
}

